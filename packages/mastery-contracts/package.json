{
  "name": "@pom/mastery-contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Versioned Atlas, Timeline, Run and public item contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./build-xml": {
      "types": "./dist/buildXml.d.ts",
      "default": "./dist/buildXml.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "sax": "^1.6.1"
  }
}
